{
  "manifest_version": 3,
  "name": "NF Extension",
  "version": "1.5.0",
  "description": "Pin your favorite Twitch and Kick streamers in the Twitch sidebar, plus optional sidebar, player and chat tweaks.",
  "homepage_url": "https://github.com/Nasseralenezd/NF-Extension",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NF Extension",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://kick.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/shared/storage.js",
        "src/content/dom.js",
        "src/content/features/pinned.js",
        "src/content/features/kick.js",
        "src/content/features/autoExpand.js",
        "src/content/features/hideForYou.js",
        "src/content/features/sidebarClutter.js",
        "src/content/features/starButton.js",
        "src/content/features/scrollVolume.js",
        "src/content/features/autoQuality.js",
        "src/content/features/autoTheater.js",
        "src/content/features/shortcuts.js",
        "src/content/features/autoClaim.js",
        "src/content/features/cleanChat.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/content.css",
        "src/shared/osd.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/shared/storage.js",
        "src/kick/scrollVolume.js"
      ],
      "css": [
        "src/shared/osd.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
