{
  "manifest_version": 3,
  "name": "NF Extension",
  "version": "1.9.0",
  "description": "Pin your favorite Twitch, Kick and YouTube streamers in the Twitch sidebar, plus optional tweaks for Twitch, Kick, YouTube and X.",
  "homepage_url": "https://github.com/Nasseralenezd/NF-Extension",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NF Extension",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://www.twitch.tv/*",
    "https://kick.com/*",
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/shared/storage.js",
        "src/content/dom.js",
        "src/content/features/pinned.js",
        "src/content/features/kick.js",
        "src/content/features/youtubeLive.js",
        "src/content/features/autoExpand.js",
        "src/content/features/hideForYou.js",
        "src/content/features/sidebarClutter.js",
        "src/content/features/starButton.js",
        "src/content/features/scrollVolume.js",
        "src/shared/audio.js",
        "src/content/features/audioCompressor.js",
        "src/content/features/volumeBoost.js",
        "src/content/features/pipButton.js",
        "src/content/features/catchUp.js",
        "src/content/features/autoQuality.js",
        "src/content/features/autoTheater.js",
        "src/content/features/dvr.js",
        "src/content/features/autoRefresh.js",
        "src/content/features/frontPageAutoplay.js",
        "src/content/features/shortcuts.js",
        "src/content/features/autoClaim.js",
        "src/content/features/cleanChat.js",
        "src/content/features/chatFavorites.js",
        "src/content/features/chatFilter.js",
        "src/content/features/chatWidth.js",
        "src/shared/preview.js",
        "src/content/features/streamPreview.js",
        "src/shared/fullscreenChat.js",
        "src/content/features/fullscreenChat.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/content.css",
        "src/shared/osd.css",
        "src/shared/preview.css",
        "src/shared/fullscreenChat.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/content/dvr-main.js",
        "src/content/catchup-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ext-twitch.tv/*"
      ],
      "js": [
        "src/content/extension-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/shared/storage.js",
        "src/kick/scrollVolume.js",
        "src/kick/quality.js",
        "src/shared/preview.js",
        "src/kick/preview.js",
        "src/shared/fullscreenChat.js",
        "src/kick/fullscreenChat.js",
        "src/kick/sidebar.js",
        "src/kick/star.js",
        "src/shared/audio.js",
        "src/kick/player.js",
        "src/kick/theater.js",
        "src/kick/cleanChat.js",
        "src/kick/compressor.js",
        "src/kick/autoRefresh.js",
        "src/kick/shortcuts.js"
      ],
      "css": [
        "src/shared/osd.css",
        "src/shared/preview.css",
        "src/shared/fullscreenChat.css",
        "src/kick/kick.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/shared/storage.js",
        "src/shared/audio.js",
        "src/youtube/youtube.js",
        "src/youtube/watched.js",
        "src/youtube/player.js"
      ],
      "css": [
        "src/shared/osd.css",
        "src/youtube/youtube.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/youtube/youtube-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/shared/storage.js",
        "src/twitter/dim.js",
        "src/twitter/tidy.js"
      ],
      "css": [
        "src/twitter/twitter.css"
      ],
      "run_at": "document_start"
    }
  ]
}
